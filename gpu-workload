#!/usr/bin/env python3
"""gpu-workload: hand the single 16 GB GPU between Strata (local LLM) and ComfyUI.

The two can't hold VRAM at the same time, so the GPU is in one of these modes:

  strata    Strata's model is loaded; ComfyUI holds no models and has no jobs.
  comfy     Strata's model is unloaded; ComfyUI may load models and run jobs.
  conflict  Strata is loaded while ComfyUI holds models or has jobs queued.

The mode is always derived from the live servers and nvidia-smi, never from a
state file, so `status` can't drift from reality and `switch` is idempotent:
switching to the mode you're already in only re-verifies it.

Commands:
  gpu-workload status [--json]
  gpu-workload switch strata|comfy [--wait SECONDS] [--json]
  gpu-workload check  strata|comfy [--json]
  gpu-workload hold comfy [--wait SECONDS] -- COMMAND...
  gpu-workload hook strata-before-load      (Strata's before_load; not for humans)

Exit codes: 0 ok · 1 failed / refused · 2 usage · 3 `check` found the wrong mode.
`hold` exits with COMMAND's own exit code once COMMAND has started.
"""

import argparse
import datetime
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

STRATA_URL = os.environ.get("GPU_WORKLOAD_STRATA_URL", "http://127.0.0.1:2335")
COMFY_URL = os.environ.get("GPU_WORKLOAD_COMFY_URL", "http://127.0.0.1:8188")
STRATA_UNIT = os.environ.get("GPU_WORKLOAD_STRATA_UNIT", "strata")
COMFY_UNIT = os.environ.get("GPU_WORKLOAD_COMFY_UNIT", "comfyui")
# nvidia-smi process paths that identify each server's GPU allocations.
STRATA_PROC = os.environ.get("GPU_WORKLOAD_STRATA_PROC", "/Strata/")
COMFY_PROC = os.environ.get("GPU_WORKLOAD_COMFY_PROC", "/ComfyUI/")
# ComfyUI's CUDA context alone is ~450 MiB; above this it is holding models.
COMFY_IDLE_MIB = int(os.environ.get("GPU_WORKLOAD_COMFY_IDLE_MIB", "1500"))
# /free empties ComfyUI's VRAM but not its RAM: after a video render it kept ~11 GiB
# (RAM + swap), and Strata's ~38 GiB load on top pushed the machine into memory
# pressure. Above this (RAM + swap, MiB) an idle ComfyUI is restarted before Strata loads.
COMFY_RESTART_MIB = int(os.environ.get("GPU_WORKLOAD_COMFY_RESTART_MIB", "4096"))
# A restart wipes ComfyUI's /history. comfy-render polls it every 2 s, so a job that
# finished less than this long ago may not have been reported yet: wait first.
COMFY_HISTORY_SETTLE_S = 10
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "gpu-workload"
LOCK_FILE = STATE_DIR / "switch.lock"      # holds the target mode while a switch or hold runs
EVENTS_FILE = STATE_DIR / "events.jsonl"   # every switch and every hook decision
EVENTS_KEEP = 500
# Set in a `hold` command's environment, so a nested `switch` to the held mode is a no-op
# instead of deadlocking on the lock the hold owns.
HOLD_ENV = "GPU_WORKLOAD_HOLD"
# The hook must finish inside Strata's before_load_timeout_s (90 s): /free ~2 s (or a
# 20 s timeout when it can't empty VRAM), then possibly the history settle (<= 10 s)
# and a ComfyUI restart (~15-20 s, up to COMFY_RESTART_TIMEOUT_S).
HOOK_RELEASE_TIMEOUT_S = 20
COMFY_RESTART_TIMEOUT_S = 50

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_WRONG_MODE = 0, 1, 2, 3


class SwitchError(Exception):
    pass


# --- probes ------------------------------------------------------------------


def _http(method: str, url: str, body: dict | None = None, timeout: float = 5.0):
    """Return (status, parsed JSON or text), or (None, error string) if unreachable."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status, raw = resp.status, resp.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        return None, str(getattr(e, "reason", e))
    try:
        return status, json.loads(raw) if raw else None
    except json.JSONDecodeError:
        return status, raw.decode(errors="replace")


def _unit_active(unit: str) -> bool:
    r = subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit])
    return r.returncode == 0


def _gpu() -> dict:
    """Card totals plus per-server VRAM use, from nvidia-smi."""
    out = {"total_mib": None, "free_mib": None, "strata_mib": 0, "comfy_mib": 0, "other_mib": 0}
    try:
        card = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.total,memory.free", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout.splitlines()[0]
        out["total_mib"], out["free_mib"] = (int(x) for x in card.split(","))
        apps = subprocess.run(
            ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout
    except (OSError, subprocess.SubprocessError, IndexError, ValueError) as e:
        out["error"] = f"nvidia-smi failed: {e}"
        return out
    for line in apps.splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) != 3 or not parts[2].isdigit():
            continue
        name, mib = parts[1], int(parts[2])
        key = "strata_mib" if STRATA_PROC in name else "comfy_mib" if COMFY_PROC in name else "other_mib"
        out[key] += mib
    return out


def _unit_mib(unit: str) -> dict:
    """A unit's anonymous memory and swap (MiB), from its cgroup. Page cache is left
    out of ram_mib: the kernel drops it under pressure. file_mib (page cache charged
    to the unit) is reported on its own, to see whether that assumption holds."""
    out = {"ram_mib": None, "swap_mib": None, "file_mib": None}
    r = subprocess.run(["systemctl", "--user", "show", unit, "-p", "ControlGroup", "--value"],
                       capture_output=True, text=True)
    cgroup = r.stdout.strip()
    if not cgroup:
        return out
    base = Path("/sys/fs/cgroup") / cgroup.lstrip("/")
    try:
        for line in (base / "memory.stat").read_text().splitlines():
            key, value = line.split()
            if key in ("anon", "file"):
                out["ram_mib" if key == "anon" else "file_mib"] = int(value) // 2**20
        out["swap_mib"] = int((base / "memory.swap.current").read_text()) // 2**20
    except (OSError, ValueError):
        pass
    return out


def _ram() -> dict:
    """Machine RAM and swap (MiB) from /proc/meminfo, plus each server's share."""
    out = {"total_mib": None, "available_mib": None, "swap_total_mib": None, "swap_used_mib": None}
    try:
        info = {k: int(v.split()[0]) // 1024 for k, v in
                (line.split(":", 1) for line in Path("/proc/meminfo").read_text().splitlines())}
        out.update(total_mib=info["MemTotal"], available_mib=info["MemAvailable"],
                   swap_total_mib=info["SwapTotal"], swap_used_mib=info["SwapTotal"] - info["SwapFree"])
    except (OSError, KeyError, ValueError) as e:
        out["error"] = f"/proc/meminfo: {e}"
    out["strata"] = _unit_mib(STRATA_UNIT)
    out["comfy"] = _unit_mib(COMFY_UNIT)
    return out


def _comfy_held_mib() -> int:
    """ComfyUI's RAM plus swap (MiB), 0 if unknown."""
    m = _unit_mib(COMFY_UNIT)
    return (m["ram_mib"] or 0) + (m["swap_mib"] or 0)


def probe() -> dict:
    strata = {"service": _unit_active(STRATA_UNIT), "reachable": False, "loaded": False}
    if strata["service"]:
        code, body = _http("GET", f"{STRATA_URL}/health")
        if code == 200 and isinstance(body, dict):
            strata.update(reachable=True, loaded=bool(body.get("loaded")))

    comfy = {"service": _unit_active(COMFY_UNIT), "reachable": False, "running": 0, "pending": 0}
    if comfy["service"]:
        code, body = _http("GET", f"{COMFY_URL}/queue")
        if code == 200 and isinstance(body, dict):
            comfy.update(
                reachable=True,
                running=len(body.get("queue_running") or []),
                pending=len(body.get("queue_pending") or []),
            )

    gpu = _gpu()
    comfy["holds_models"] = gpu["comfy_mib"] > COMFY_IDLE_MIB
    comfy_active = comfy["holds_models"] or comfy["running"] or comfy["pending"]
    # nvidia-smi is the tiebreaker if /health is unreachable but the engine is on the GPU.
    strata_on_gpu = strata["loaded"] or gpu["strata_mib"] > 0

    if strata_on_gpu and comfy_active:
        mode = "conflict"
    elif strata_on_gpu:
        mode = "strata"
    else:
        mode = "comfy"
    return {"mode": mode, "strata": strata, "comfy": comfy, "gpu": gpu, "ram": _ram(),
            "last_event": last_event()}


def _describe(s: dict) -> str:
    st, cf, g = s["strata"], s["comfy"], s["gpu"]
    if not st["service"]:
        strata = "service stopped"
    elif not st["reachable"]:
        strata = "service up, API not answering"
    else:
        strata = "model loaded" if st["loaded"] else "model unloaded (lazy)"
    if not cf["service"]:
        comfy = "service stopped"
    elif not cf["reachable"]:
        comfy = "service up, API not answering"
    else:
        jobs = f"{cf['running']} running / {cf['pending']} queued"
        comfy = f"{'models loaded' if cf['holds_models'] else 'no models loaded'}, {jobs}"
    gpu = (
        f"{g['free_mib']} of {g['total_mib']} MiB free "
        f"(strata {g['strata_mib']}, comfy {g['comfy_mib']}, other {g['other_mib']})"
        if "error" not in g else g["error"]
    )
    out = f"mode:   {s['mode']}\nstrata: {strata}\ncomfy:  {comfy}\ngpu:    {gpu}\nram:    {_describe_ram(s['ram'])}"
    if ev := s.get("last_event"):
        detail = ", ".join(f"{k}={v}" for k, v in ev.items() if k not in ("time", "event"))
        out += f"\nlast:   {ev['time']} {ev['event']}" + (f" ({detail})" if detail else "")
    return out


def _describe_ram(r: dict) -> str:
    if "error" in r:
        return r["error"]

    def gib(mib):
        return f"{mib / 1024:.1f}"

    def share(name):
        m = r[name]
        if m["ram_mib"] is None:
            return f"{name} -"
        swap = f" + {gib(m['swap_mib'])} swap" if m["swap_mib"] else ""
        return f"{name} {gib(m['ram_mib'])} GiB{swap}"

    return (f"{gib(r['available_mib'])} of {gib(r['total_mib'])} GiB available, "
            f"swap {gib(r['swap_used_mib'])} of {gib(r['swap_total_mib'])} GiB used "
            f"({share('strata')}, {share('comfy')})")


# --- events ------------------------------------------------------------------


def record(kind: str, **fields) -> None:
    """Append one event; the log is trimmed to the last EVENTS_KEEP lines."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    event = {"time": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "event": kind, **fields}
    lines = EVENTS_FILE.read_text().splitlines() if EVENTS_FILE.exists() else []
    lines = [*lines[-(EVENTS_KEEP - 1):], json.dumps(event)]
    tmp = EVENTS_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(EVENTS_FILE)


def last_event() -> dict | None:
    if not EVENTS_FILE.exists():
        return None
    lines = EVENTS_FILE.read_text().splitlines()
    try:
        return json.loads(lines[-1]) if lines else None
    except json.JSONDecodeError:
        return None


# --- switching ---------------------------------------------------------------


def _wait_until(pred, timeout: float, what: str, poll: float = 1.0):
    deadline = time.monotonic() + timeout
    while True:
        value = pred()
        if value:
            return value
        if time.monotonic() >= deadline:
            raise SwitchError(f"timed out after {timeout:g}s waiting for {what}")
        time.sleep(poll)


def _ensure_unit(unit: str, health_url: str, timeout: float = 60.0) -> None:
    if not _unit_active(unit):
        _log(f"starting {unit}.service")
        r = subprocess.run(["systemctl", "--user", "start", unit], capture_output=True, text=True)
        if r.returncode != 0:
            raise SwitchError(f"systemctl --user start {unit} failed: {r.stderr.strip()}")
    _wait_until(lambda: _http("GET", health_url)[0] == 200, timeout, f"{unit} to answer {health_url}")


def _comfy_jobs() -> int:
    code, body = _http("GET", f"{COMFY_URL}/queue")
    if code != 200 or not isinstance(body, dict):
        return 0
    return len(body.get("queue_running") or []) + len(body.get("queue_pending") or [])


def free_comfy(wait: float, release_timeout: float = 60) -> None:
    """Make ComfyUI drop its models. Fails at once if it has jobs, unless `wait`
    gives them that long to finish: a render is never interrupted."""
    if _comfy_jobs():
        if not wait:
            raise SwitchError("ComfyUI has jobs running or queued (use --wait SECONDS to wait for them)")
        _log("waiting for ComfyUI's queue to drain")
        _wait_until(lambda: _comfy_jobs() == 0, wait, "ComfyUI's queue to drain", poll=2.0)
    # /free only takes effect between jobs. If one is queued after the check above,
    # the free is postponed past it and the wait below times out: fail, not collide.
    code, body = _http("POST", f"{COMFY_URL}/free", {"unload_models": True, "free_memory": True})
    if code != 200:
        raise SwitchError(f"ComfyUI /free failed: {code} {body}")
    _wait_until(
        lambda: _gpu()["comfy_mib"] <= COMFY_IDLE_MIB, release_timeout,
        f"ComfyUI to release VRAM (below {COMFY_IDLE_MIB} MiB); was a new job queued?",
    )


def _comfy_last_finish() -> float | None:
    """When ComfyUI's newest /history entry finished (epoch seconds), or None."""
    code, body = _http("GET", f"{COMFY_URL}/history?max_items=1")
    if code != 200 or not isinstance(body, dict) or not body:
        return None
    entry = list(body.values())[-1]
    stamps = [m[1].get("timestamp") for m in (entry.get("status") or {}).get("messages") or []
              if isinstance(m, list) and len(m) == 2 and isinstance(m[1], dict)]
    stamps = [t for t in stamps if isinstance(t, (int, float))]
    return max(stamps) / 1000 if stamps else None


def restart_comfy(timeout: float, why: str) -> None:
    """Restart an idle ComfyUI. A restart wipes /history, so it first waits until
    the newest job finished COMFY_HISTORY_SETTLE_S ago (comfy-render has read it
    by then), and re-checks the queue right before stopping."""
    if (done := _comfy_last_finish()) is not None:
        if (left := done + COMFY_HISTORY_SETTLE_S - time.time()) > 0:
            _log(f"waiting {left:.0f}s so the last job's result is read before the restart")
            time.sleep(left)
    if _comfy_jobs():
        raise SwitchError("a ComfyUI job was queued just now; not restarting it")
    _log(f"restarting ComfyUI: {why}")
    r = subprocess.run(["systemctl", "--user", "restart", COMFY_UNIT], capture_output=True, text=True)
    if r.returncode != 0:
        raise SwitchError(f"systemctl --user restart {COMFY_UNIT} failed: {r.stderr.strip()}")
    _wait_until(lambda: _http("GET", f"{COMFY_URL}/queue")[0] == 200, timeout,
                f"{COMFY_UNIT} to answer after its restart")


def make_room_in_comfy(wait: float, release_timeout: float) -> list[str]:
    """Free ComfyUI's models, and restart it when that isn't enough, so Strata
    can load. Returns what was done, for the event log.

    Restarts when its VRAM won't drop below COMFY_IDLE_MIB with the queue empty
    (an extension that doesn't unload fully, e.g. IndexTTS without our patch),
    or when its RAM + swap stays above COMFY_RESTART_MIB."""
    done = []
    if (held := _gpu()["comfy_mib"]) > COMFY_IDLE_MIB or _comfy_jobs():
        try:
            free_comfy(wait, release_timeout)
            done.append(f"freed its {held} MiB of models")
        except SwitchError:
            # A job queued since the check postpones /free past it: never restart then.
            if _comfy_jobs():
                raise
            stuck = _gpu()["comfy_mib"]
            restart_comfy(COMFY_RESTART_TIMEOUT_S, f"it kept {stuck} MiB of VRAM after /free")
            return [*done, f"restarted it: kept {stuck} MiB of VRAM after /free"]
    if (ram := _comfy_held_mib()) > COMFY_RESTART_MIB:
        restart_comfy(COMFY_RESTART_TIMEOUT_S, f"it holds {ram} MiB of RAM + swap with no models loaded")
        done.append(f"restarted it to release {ram} MiB of RAM + swap")
    return done


def to_strata(wait: float) -> None:
    s = probe()
    if s["mode"] == "strata":
        _log("already in strata mode")
        return

    if s["comfy"]["service"]:
        _ensure_unit(COMFY_UNIT, f"{COMFY_URL}/queue")
        make_room_in_comfy(wait, release_timeout=60)

    _ensure_unit(STRATA_UNIT, f"{STRATA_URL}/health")
    _log("loading Strata's model")
    # Synchronous: answers once the engine is up. A cold load reads ~33 GB of experts.
    code, body = _http("POST", f"{STRATA_URL}/load", {}, timeout=max(300.0, wait))
    if code != 200:
        raise SwitchError(f"Strata /load failed: {code} {body}")
    if probe()["mode"] != "strata":
        raise SwitchError("Strata reported loaded, but the mode isn't strata; run `gpu-workload status`")


def to_comfy(wait: float) -> None:
    s = probe()
    if s["strata"]["service"]:
        # Always ask Strata, even when it looks unloaded: a load may be under way
        # (its engine not on the GPU yet), and /unload waits behind it. When it
        # is already unloaded this costs one request and answers "not loaded".
        _ensure_unit(STRATA_UNIT, f"{STRATA_URL}/health")
        # wait=N lets a running answer finish; without it Strata answers "busy" at once.
        url = f"{STRATA_URL}/unload" + (f"?wait={int(wait)}" if wait else "")
        code, body = _http("POST", url, {}, timeout=wait + 30)
        status = body.get("status") if isinstance(body, dict) else body
        if code == 409 or status == "busy":
            raise SwitchError("Strata is answering or loading (use --wait SECONDS to let it finish)")
        if code != 200 or status not in ("unloaded", "not loaded"):
            raise SwitchError(f"Strata /unload failed: {code} {body}")
        _wait_until(lambda: _gpu()["strata_mib"] == 0, 30, "Strata's engine to leave the GPU")
    elif s["gpu"]["strata_mib"]:
        raise SwitchError("a Strata process holds VRAM but strata.service is stopped; kill it by hand")

    _ensure_unit(COMFY_UNIT, f"{COMFY_URL}/queue")
    if probe()["mode"] != "comfy":
        raise SwitchError("Strata unloaded, but the mode isn't comfy; run `gpu-workload status`")


# --- Strata before_load hook ---------------------------------------------------


def strata_before_load() -> int:
    """Run by Strata before it loads its model (its `before_load`, with
    `before_load_strict`, so a non-zero exit becomes a 503 and no load).

    - A `switch strata` in progress triggered this load: allow at once. Waiting
      on the lock here would deadlock, since that switch holds it while it
      blocks on Strata's /load.
    - A `switch comfy` or `hold comfy` in progress: refuse.
    - Otherwise a request woke the lazy model. ComfyUI rendering or with jobs
      queued: refuse, a render is never interrupted. ComfyUI idle: free its
      models if it holds any, restart it if its VRAM won't drop or it still
      holds a lot of RAM, then allow.

    It frees ComfyUI itself rather than calling `switch strata`: that ends in
    Strata's /load, which would wait on the very load running this hook. The
    lock is held throughout, so a `switch comfy` starting now waits for it.
    Strata itself is not queried; it is busy loading.
    """
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.seek(0)
            holder = lock.read().strip() or "a switch"
            allowed = holder == "switch strata"
            record("strata-load", source="hook", allowed=allowed, reason=f"{holder} in progress")
            if not allowed:
                _log(f"refusing Strata load: {holder} is in progress")
            return EXIT_OK if allowed else EXIT_FAIL

        gpu = _gpu()
        jobs = _comfy_jobs()
        if "error" in gpu:
            reason = gpu["error"]
        elif jobs:
            reason = f"ComfyUI has {jobs} job(s) running or queued"
        else:
            try:
                done = make_room_in_comfy(wait=0, release_timeout=HOOK_RELEASE_TIMEOUT_S)
            except SwitchError as e:
                reason = f"could not make room in ComfyUI: {e}"
            else:
                # What memory Strata loads into: oomd killed loads that skipped the restart.
                ram = _ram()
                record("strata-load", source="request", allowed=True, reason="; ".join(["ComfyUI idle", *done]),
                       available_mib=ram["available_mib"], comfy=ram["comfy"])
                return EXIT_OK
        record("strata-load", source="request", allowed=False, reason=reason)
        _log(f"refusing Strata load: {reason}")
        return EXIT_FAIL


# --- hold ----------------------------------------------------------------------


def hold_comfy(command: list[str], wait: float) -> int:
    """Switch to comfy and keep the GPU there until COMMAND exits.

    Holding the lock marked "comfy" makes the hook refuse every Strata load,
    so a render script may leave ComfyUI's queue empty between its jobs."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            _log("waiting for another switch or hold to finish")
            fcntl.flock(lock, fcntl.LOCK_EX)
        _mark(lock, "hold comfy")
        try:
            before = probe()["mode"]
            try:
                to_comfy(wait)
            except SwitchError as e:
                record("hold", mode="comfy", ok=False, error=str(e))
                _log(f"hold comfy failed: {e}")
                return EXIT_FAIL
            record("hold", mode="comfy", ok=True, previous=before, command=" ".join(command)[:200])
            try:
                proc = subprocess.Popen(command, env={**os.environ, HOLD_ENV: "comfy"})
            except OSError as e:
                record("hold-end", mode="comfy", ok=False, error=str(e))
                _log(f"could not run {command[0]}: {e}")
                return EXIT_FAIL
            # Pass termination on, so the lock is never released under a running render.
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(sig, lambda signum, _frame: proc.send_signal(signum))
            code = proc.wait()
            record("hold-end", mode="comfy", exit=code)
            return code
        finally:
            _mark(lock, "")


def _mark(lock, holder: str) -> None:
    """Say what the lock holder is doing ("switch strata", "hold comfy", "" when done).
    The hook allows a Strata load only during "switch strata"."""
    lock.seek(0)
    lock.truncate()
    lock.write(holder)
    lock.flush()


# --- CLI ---------------------------------------------------------------------

_json_out = False


def _log(msg: str) -> None:
    print(f"gpu-workload: {msg}", file=sys.stderr)


def _emit(s: dict, extra: dict | None = None) -> None:
    if _json_out:
        print(json.dumps({**s, **(extra or {})}))
    else:
        print(_describe(s))


def main(argv: list[str] | None = None) -> int:
    global _json_out
    p = argparse.ArgumentParser(prog="gpu-workload", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, help_ in (("status", "show the current mode"),
                        ("switch", "move the GPU to a workload (idempotent)"),
                        ("check", "exit 0 if in MODE, 3 otherwise"),
                        ("hold", "switch to MODE and keep it until COMMAND exits")):
        sp = sub.add_parser(name, help=help_)
        if name != "hold":
            sp.add_argument("--json", action="store_true", help="machine-readable output on stdout")
        if name == "hold":
            sp.add_argument("mode", choices=("comfy",))
        elif name != "status":
            sp.add_argument("mode", choices=("strata", "comfy"))
        if name in ("switch", "hold"):
            sp.add_argument("--wait", type=float, default=0, metavar="SECONDS",
                            help="wait this long for running work to finish instead of failing")
    sub.choices["hold"].add_argument("command", nargs=argparse.REMAINDER, metavar="-- COMMAND...")
    hp = sub.add_parser("hook", help="entry points for server hooks")
    hp.add_argument("name", choices=("strata-before-load",))
    args = p.parse_args(argv)
    _json_out = getattr(args, "json", False)

    if args.cmd == "hook":
        return strata_before_load()

    if args.cmd == "hold":
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if not command:
            p.error("hold needs a command after --")
        if os.environ.get(HOLD_ENV) == "comfy":
            # Already inside a hold: our parent owns the lock, so taking it would deadlock.
            return subprocess.call(command)
        return hold_comfy(command, args.wait)

    if args.cmd == "status":
        _emit(probe())
        return EXIT_OK

    if args.cmd == "check":
        s = probe()
        # comfy mode with ComfyUI down is no use to a comfy workflow.
        ok = s["mode"] == args.mode and (args.mode != "comfy" or s["comfy"]["reachable"])
        _emit(s, {"ok": ok, "want": args.mode})
        if not ok and not _json_out:
            _log(f"GPU is in {s['mode']} mode, not {args.mode}; run `gpu-workload switch {args.mode}`")
        return EXIT_OK if ok else EXIT_WRONG_MODE

    held = os.environ.get(HOLD_ENV)
    if held:
        # Inside `hold`: our parent owns the lock, so taking it would deadlock.
        if held != args.mode:
            _log(f"can't switch to {args.mode} inside `hold {held}`")
            return EXIT_FAIL
        _emit(probe(), {"ok": True, "held": held})
        return EXIT_OK

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK_FILE, "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            _log("waiting for another switch or hold to finish")
            fcntl.flock(lock, fcntl.LOCK_EX)
        # The hook reads this to tell the load we trigger from a stray one.
        _mark(lock, f"switch {args.mode}")
        before = probe()["mode"]
        try:
            (to_strata if args.mode == "strata" else to_comfy)(args.wait)
        except SwitchError as e:
            record("switch", to=args.mode, ok=False, error=str(e))
            _log(f"switch to {args.mode} failed: {e}")
            _emit(probe(), {"ok": False, "error": str(e)})
            return EXIT_FAIL
        finally:
            _mark(lock, "")
        if before != args.mode:
            record("switch", to=args.mode, ok=True, previous=before)
    _emit(probe(), {"ok": True})
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
